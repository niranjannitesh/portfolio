---
interface Props {
  heading: string
}

const { heading } = Astro.props
---

<div class="px-6">
  <main class="w-full max-w-2xl mx-auto mt-24 mb-40 sm:mt-32">
    <h1 class="text-xl font-medium">{heading}</h1>
    <p class="mt-4 text-[#676767]"><slot name="intro" /></p>
    <div class="mt-16"><slot /></div>
  </main>
</div>
