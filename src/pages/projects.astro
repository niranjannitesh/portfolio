---
import BaseLayout from "@/layouts/BaseLayout.astro"
import PageShell from "@/components/PageShell.astro"
import ExternalLink from "@/components/ExternalLink.astro"
import { projects, earlierProjects } from "@/data/projects"

const description =
  "Speech models, agent infrastructure, a memory layer, and a Postgres client. Things I have built, most of them still running."
---

<BaseLayout title="Projects" description={description}>
  <PageShell heading="Projects">
    <Fragment slot="intro">things I&apos;ve built</Fragment>

    <div class="flex flex-col space-y-16">
      {
        projects.map((project) => (
          <article>
            <p class="text-sm text-[#5A5A5A]">{project.eyebrow}</p>
            <h2 class="mt-2 font-medium text-[#EDEDED]">{project.name}</h2>
            <p class="mt-3 text-sm leading-7 text-[#676767]">
              {project.description}
            </p>
            <div class="flex flex-wrap gap-2 mt-5">
              {project.links.map((link) => (
                <ExternalLink href={link.href}>{link.label}</ExternalLink>
              ))}
            </div>
          </article>
        ))
      }
    </div>

    <section class="pt-16 mt-20 border-t border-[#1B1B1B]">
      <h2 class="text-sm text-[#5A5A5A]">Further back</h2>
      <div class="flex flex-col mt-10 space-y-14">
        {
          earlierProjects.map((project) => (
            <article>
              <p class="text-sm text-[#5A5A5A]">{project.eyebrow}</p>
              <h3 class="mt-2 font-medium text-[#EDEDED]">{project.name}</h3>
              <p class="mt-3 text-sm leading-7 text-[#676767]">
                {project.description}
              </p>
              <div class="flex flex-wrap gap-2 mt-5">
                {project.links.map((link) => (
                  <ExternalLink href={link.href}>{link.label}</ExternalLink>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </section>
  </PageShell>
</BaseLayout>
